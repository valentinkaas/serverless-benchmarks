ARG BASE_IMAGE
FROM $BASE_IMAGE

WORKDIR /workspace

USER root

COPY . function/
RUN mv function/handler.js function/package.json function/package-lock.json /workspace

ENV NODE_ENV=production

# The GCP runtime provides the functions framework to code packages, so it is not locked.
RUN npm ci --omit=dev \
    && npm install --no-save --omit=dev @google-cloud/functions-framework@5.0.2 \
    && npm cache clean --force

CMD ["node", "./node_modules/@google-cloud/functions-framework/build/src/main.js", "--target=handler", "--source=handler.js"]
